# Hermes worker en Railway (servicio hermes-worker). Nombres nada más.
# Los valores van en las variables del servicio, no en git. Ver CLOUD.md.
# No copies aquí los secretos de Studio (APP_ACCESS_PASSWORD, SUPABASE_*, RESEND_API_KEY, SESSION_SECRET).

# La pone el entrypoint; no hace falta definirla en Railway.
# HERMES_CLOUD=1

# URL pública https de hermes-studio y el mismo WORKER_TOKEN que ese servicio.
STUDIO_WORKER_URL=
WORKER_TOKEN=

# Opcionales. Vacías = el comportamiento de siempre (hermes en PATH, 180 min de tope duro, razonamiento high en la primera versión).
# HERMES_JOB_TIMEOUT_MIN (defecto 20) entrega el HTML si pasa las comprobaciones; si no, falla.
# WORKER_CONCURRENCY (defecto 2) son huecos en paralelo, cada uno con su carpeta bajo HERMES_HOME.
HERMES_BIN=
HERMES_TIMEOUT_MIN=
HERMES_JOB_TIMEOUT_MIN=
WORKER_CONCURRENCY=
HERMES_PHASE_MEASURE_MIN=
HERMES_PHASE_PRODUCT_MIN=
HERMES_PHASE_BRIEF_MIN=
HERMES_PHASE_DRAFT_MIN=
HERMES_PHASE_SELFAUDIT_MIN=
HERMES_PHASE_FIX_MIN=
HERMES_PHASE_ART_MIN=
HERMES_PHASE_ART_REVISE_MIN=
HERMES_PHASE_CHECK_MIN=
HERMES_FIX_ROUNDS=
HERMES_MAX_CONTINUES=
HERMES_ART_REVISE_PASSES=
HERMES_ART_REPAIR_RETRIES=
HERMES_ART_SCREENSHOTS=
HERMES_ART_COMPARES=
HERMES_STALL_MIN=
HERMES_MODEL_ART=
HERMES_MODEL_BRIEF=
HERMES_MODEL_DRAFT=
HERMES_MODEL_FIX=
HERMES_REASONING_DRAFT=
HERMES_KEEP_RULES=

# Un proveedor basta. Si el nombre no está en studio/worker/cloudEnv.ts, el entrypoint lo tira.
# La sesión OAuth del Mac no está en la imagen. Con NOUS_API_KEY y sin auth.json en el volumen,
# el worker usa provider custom:nous-api (clave en key_env, no en el yaml) y el modelo
# deepseek/deepseek-v4-flash. nous-api a secas no existe en el CLI. Ver CLOUD.md.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NOUS_API_KEY=

# Opcionales. Vacías = custom:nous-api + deepseek/deepseek-v4-flash cuando hay NOUS_API_KEY y no hay sesión.
# HERMES_PROVIDER=nous-api se lee como custom:nous-api. nous sigue siendo el OAuth.
HERMES_PROVIDER=
HERMES_INFERENCE_MODEL=
