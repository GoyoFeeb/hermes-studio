# Hermes worker en Railway (servicio hermes-worker). Nombres nada más.
# Los valores van en las variables del servicio, no en git. Ver CLOUD.md.
# No copies aquí los secretos de Studio (APP_ACCESS_PASSWORD, SUPABASE_*, RESEND_API_KEY, SESSION_SECRET).

# La pone el entrypoint; no hace falta definirla en Railway.
# HERMES_CLOUD=1

# URL pública https de hermes-studio y el mismo WORKER_TOKEN que ese servicio.
STUDIO_WORKER_URL=
WORKER_TOKEN=

# Opcionales. Vacías = el comportamiento de siempre (hermes en PATH, 180 min, razonamiento high en la primera versión).
HERMES_BIN=
HERMES_TIMEOUT_MIN=
HERMES_STALL_MIN=
HERMES_MODEL_ART=
HERMES_MODEL_BRIEF=
HERMES_MODEL_DRAFT=
HERMES_MODEL_FIX=
HERMES_REASONING_DRAFT=
HERMES_KEEP_RULES=

# Un proveedor basta. Si el nombre no está en studio/worker/cloudEnv.ts, el entrypoint lo tira.
# La sesión de Nous también puede vivir en el volumen (HERMES_HOME), fuera del repo.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NOUS_API_KEY=
