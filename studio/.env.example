# Hermes Studio — variables propias del servicio (además de OPENAI_API_KEY / ANTHROPIC_API_KEY,
# que ya viven en el .env de la raíz del repo — ver ../.env.example).

# Contraseña compartida de equipo (Basic Auth).
APP_ACCESS_PASSWORD=

# Auditoría 2026-09-23: si dejas APP_ACCESS_PASSWORD vacía, el servicio ya NO arranca abierto en
# silencio — se niega a arrancar salvo que pongas este flag explícito a "true" (solo desarrollo
# local). Para cualquier deploy real (Railway/Docker), borra o pon en false esta línea y fija
# APP_ACCESS_PASSWORD arriba en su lugar.
ALLOW_NO_AUTH=true

# Puerto donde escucha el servidor.
PORT=3000

# URL pública https donde este servicio está desplegado (detrás de tu proxy/TLS). Se usa para
# construir las URLs de las imágenes que el propio servicio genera y sirve (hero, logo
# capturado) en campaign-data.json — el schema del motor exige https, así que en producción
# esto NO puede quedarse como http://localhost.
STUDIO_PUBLIC_BASE_URL=http://localhost:3000

# Proveedor del modelo de texto de las fases (2026-09-24). Sin definir = Anthropic
# (ANTHROPIC_API_KEY, modelo claude-sonnet-5). Con "openai" usa la API de chat completions
# con OPENAI_API_KEY (o LLM_API_KEY) y el modelo gpt-5.4-mini por defecto. LLM_BASE_URL permite
# apuntar a cualquier API compatible con OpenAI (Gemini, OpenRouter...).
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5.4-mini
# LLM_REASONING_EFFORT=low
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# (Compatibilidad: STUDIO_MODEL sigue funcionando como alias de LLM_MODEL.)
# STUDIO_MODEL=claude-sonnet-5

# Enviar una prueba por correo (2026-10-05, studio/server/mail.ts). Opcional: sin las dos, la web lo dice y no
# deja enviar. MAIL_FROM tiene que ser de un dominio verificado en Resend.
# RESEND_API_KEY=
# MAIL_FROM=Hermes Studio <pruebas@feebbodigital.com>
