{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": ["scripts/**/*", "studio/scripts/**/*", "react-email-template/**/*", "newsletters/**/*", "studio/server/**/*"],
  "exclude": ["node_modules", "dist"]
}