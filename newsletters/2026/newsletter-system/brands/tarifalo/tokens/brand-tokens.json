    "footerBrand": { "size": 12, "weight": 600, "letterSpacing": "0.2px", "color": "#003049" },
    "footerTagline": { "size": 12, "weight": 400, "color": "#666666" },
    "footerDisclosure": { "size": 12, "weight": 400, "color": "#666666" },
