    "white": "#FFFFFF",
    "ctaBackground": "#F77F00",
    "ctaText": "#FFFFFF",
    "subtitleOnBrand": "#FCE4C8",
    "eyebrowOnBrand": "#004B6B",
    "bodySecondary": "#666666",
    "border": "#E0D5C5",
    "sectionLila": "#FFF1E0",
    "global": "#FFF6E7",
    "onBrandSecondary": "#FCE4C8",
