  "_changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-22",
      "summary": "Nivel 1 de tokenización de motor: typography.displayFont, radius.* y shadows.* pasan de estar hardcodeados en engine/components/*.html (con los valores literales de paraycompara, la primera marca) a leerse via {{token:...}} (ver engine/CHANGELOG.md, entrada 'Nivel 1').",
      "correctionsFound": [
        {
          "field": "typography.displayFont",
          "before": "'Sora', Arial, Helvetica, sans-serif",
          "resolved": "'Sora','Segoe UI',Arial,Helvetica,sans-serif",
          "reason": "Mismo ajuste de formato que en paraycompara (añade el fallback 'Segoe UI' y normaliza espacios) — sin cambio visual, tarifalo ya usa Sora como paraycompara."
        }
      ],
      "expectedVisualChanges": [
        {
          "field": "radius.card",
          "value": 16,
          "impact": "Las tarjetas de tarifa (card-tarifa-3, usadas en 2026-jul-comparar-luz-gas) tenían border-radius:18px hardcodeado (valor de paraycompara, no de tarifalo). Ahora usan 16px, el valor real de este pack. Cambio visual sutil e intencional — corrige la 'genericidad' reportada por el cliente (ver conversación 2026-07-22 'subir al siguiente nivel')."
        },
        {
          "field": "shadows.card",
          "value": "0 14px 32px rgba(0,48,73,0.08)",
          "impact": "card-tarifa-3.html tenía una sombra neutra hardcodeada (rgba(0,0,0,0.08), ni de paraycompara ni de tarifalo — un valor provisional al crear el componente el 2026-07-21). Ahora usa la sombra real de tarifalo (tinte navy, coherente con colors.primary #003049). Cambio visual intencional."
        },
        {
          "field": "shadows.cta",
          "value": "0 12px 28px rgba(247,127,0,0.22)",
          "impact": "El botón CTA de tarifalo (cta-bulletproof.html) tenía la sombra de paraycompara hardcodeada (tinte naranja rgba(255,90,60,0.22), el naranja DE paraycompara, no el de tarifalo). Ahora usa el tinte del naranja real de tarifalo (#F77F00). Cambio visual intencional — bug real corregido (antes todas las marcas no-paraycompara mostraban el tinte de sombra de paraycompara en su CTA)."
        }
      ],
      "verifiedByteParity": "cmp byte a byte de 2026-jul-comparar-luz-gas tras el cambio muestra diffs esperados en los 3 campos de arriba, cero diffs en cualquier otro campo — ver engine/CHANGELOG.md."
    }
  ]
}
