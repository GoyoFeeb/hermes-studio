<tr>
<td style="background-color:#F5F5F5;padding:0;">
  <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
    <tr>
      <td align="center" style="padding:40px 24px 8px;border-top:2px solid #E0E0E0;">
        <p style="font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:600;color:#111111;margin:0;line-height:1.4;letter-spacing:0.2px;text-align:center;mso-line-height-rule:exactly;">
          Nike
        </p>
        <p style="font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:400;color:#707072;margin:2px 0 0;line-height:1.4;text-align:center;mso-line-height-rule:exactly;">
          Nike
        </p>
      </td>
    </tr>
    <tr>
      <td align="center" style="padding:16px 24px 24px;">
        <hr style="border:none;border-top:1px solid #E0E0E0;margin:0 0 16px;width:100%;">
        <p style="font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:400;color:#707072;margin:0 0 12px;line-height:1.45;text-align:center;mso-line-height-rule:exactly;">
          Oferta válida hasta agotar existencias. Nike, Inc., One Bowerman Drive, Beaverton, OR 97005, USA.
        </p>
        <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
          <tr>
            <td align="center" style="padding:0 0 12px;">
