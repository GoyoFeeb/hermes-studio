<tr>
<td style="background-color:#FFFFFF;padding:0;">
  <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">

    <!-- Columna imagen + columna texto -->
    <tr>
      <!-- Imagen (46% desktop, full width mobile) -->
      <td class="mobile-stack" style="width:46%;padding:0 10px 0 0;" width="276" valign="middle">
        <img src="https://PENDING-CDN-UPLOAD/nike/editorial-af1-detail.png" alt="Detalle del upper de cuero del Air Force 1 con costuras visibles" width="276" style="display:block;outline:none;border:none;width:100%;max-width:276px;height:auto;border-radius:0px;" class="mobile-img">
      </td>
      <!-- Texto (54% desktop, full width mobile) -->
      <td class="mobile-stack" style="width:54%;padding:0 0 0 10px;" width="324" valign="middle">
        <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
          <tr>
            <td align="left" class="mobile-pad-sm" style="padding:0;">
              <p style="font-family:Arial,Helvetica,sans-serif;font-size:11px;font-weight:700;color:#111111;margin:0 0 6px;letter-spacing:1.5px;text-transform:uppercase;line-height:1.4;mso-line-height-rule:exactly;">
                DISEÑO QUE PERDURA
              </p>
              <h3 style="font-family:'Inter', Helvetica, Arial, sans-serif;font-size:18px;font-weight:800;color:#111111;margin:0 0 8px;line-height:1.25;letter-spacing:-0.3px;mso-line-height-rule:exactly;">
                Cuero, goma y aire. Nada más.
              </h3>
              <p style="font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:400;color:#707072;margin:0 0 18px;line-height:1.55;mso-line-height-rule:exactly;">
                El upper de cuero de grano completo se moldea con cada uso. La suela de goma con patrón de espina de pescado agarra el asfalto igual que a la cancha. Y la unidad Air en el talón convierte cada paso en una declaración: esto es un icono.
              </p>
              <!--[if mso]>
<v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word"
  href="https://www.nike.com/w/air-force-1-shoes-5sj3yzy7ok?utm_source=newsletter&amp;utm_medium=email&amp;utm_campaign=2026-jul-nike-air-force-one&amp;utm_content=editorial-cta" style="height:40px;v-text-anchor:middle;width:200px;"
  arcsize="50%" filled="f" fillcolor="#111111" stroked="t" strokecolor="#111111" strokeweight="1.5pt">
