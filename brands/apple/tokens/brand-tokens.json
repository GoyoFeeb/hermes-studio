{
  "brand": "apple",
  "description": "Design tokens for Apple — premium, minimalist, ecosystem-focused campaigns",
  "version": "1.0.0",
  "colors": {
    "primary": "#1D1D1F",
    "ctaBackground": "#0071E3",
    "ctaText": "#FFFFFF",
    "textSecondary": "#6E6E73",
    "white": "#FFFFFF",
    "black": "#000000",
    "link": "#0066CC",
    "lightBg": "#F5F5F7",
    "border": "#D2D2D7",
    "success": "#30D158",
    "warning": "#FFD60A",
    "error": "#FF453A",
    "footerBg": "#F5F5F7",
    "footerText": "#6E6E73"
  },
  "typography": {
    "family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Arial, Helvetica, sans-serif",
    "headline": {
      "hero": "48px",
      "h1": "44px",
      "h2": "36px",
      "h3": "32px",
      "h4": "24px",
      "h5": "21px"
    },
    "body": {
      "large": "21px",
      "normal": "18px",
      "small": "16px",
      "xsmall": "14px",
      "legal": "12px"
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.1,
      "normal": 1.4,
      "relaxed": 1.6
    }
  },
  "spacing": {
    "section": "48px 0",
    "innerSection": "32px 20px",
    "hero": "56px 0",
    "paragraph": "20px 0",
    "cta": "24px 0"
  },
  "radius": {
    "ctaPill": 50,
    "image": 0
  },
  "layout": {
    "maxWidth": 600,
    "mobileBreakpoint": 599,
    "emailWidth": 600,
    "fullWidth": "100%"
  },
  "images": {
    "heroDimensions": "1200x750px",
    "heroDisplay": "600x375px",
    "benefitDimensions": "600x400px",
    "benefitDisplay": "600x400px",
    "format": "jpg",
    "bgColor": "#FFFFFF"
  },
  "buttons": {
    "vml": true,
    "padding": "12px 28px",
    "fontSize": "17px",
    "fontWeight": 400,
    "borderRadius": 50
  },
  "copyTone": "claro, seguro, aspiracional, minimalista",
  "language": "es",
  "notes": [
    "Apple aesthetic: ZERO card borders, ZERO shadows, ZERO accent stripes",
    "Typography is the hero — massive headings, generous white space",
    "Full-bleed images within 600px container",
    "No structured card layouts — just text + image alternating",
    "Single CTA per section, clean bulletproof button",
    "Minimal color palette — primary #1D1D1F, secondary #6E6E73, cta blue #0071E3"
  ]
}
